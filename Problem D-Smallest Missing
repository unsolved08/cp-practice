#include <bits/stdc++.h>

using namespace std;

int main() {
    int n;
    cin >> n;
    multiset<long long>s;
    for (int i = 0; i < n; i++) {
        long long x;
        cin >> x;
        s.insert(x);
    }
    if (s.count(1) > 0) {
        int least = 0;
        int i = 0;
        int j = 1;
        while (least==0) {
            auto it1 = s.begin();
            advance(it1, i);
            int e1 = *it1;
            auto it2 = s.begin();
            advance(it2, j);
            int e2 = *it2;
            
               
            
            if (e1 == e2) {
                j++;                
            }
            else if (e2 == (e1 + 1)) {
                if (j == n - 1) {
                auto it3 = s.begin();
                advance(it3, n - 1);
                least = *it3 + 1;
                 cout << least;
            }else{
                    int temp = j;
                    j++;
                    i = temp;
                }
                
                
            }
            else {
                auto it4 = s.begin();
                advance(it4, i);
                least = *it4 + 1;
                cout << least;
            }
        }
    }
    else {
        cout << 1;
    }
    return 0;
}
