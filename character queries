#include <iostream>
#include <vector>
#include <algorithm>
#include<set>
#define int long long

using namespace std;
signed main() {
    int n, q;
    cin >> n >> q;
    string word;
    cin >> word;
    vector<char>alpha;
    for (int i = 0; i < n; i++) {
        char a = word[i];
        alpha.push_back(a);
    }
    for (int i = 0; i < q; i++) {
        int l, r;
        char c;
        cin >> l >> r >> c;
        int count = 0;
        
        for (int j = l - 1; j < r; j++) {
            
            if (alpha[j] == c) {
                count = count + 1;
            }
         }
        if (count > 0) {
                cout << "YES" << "\n";
        }
        else {
                cout << "NO" << "\n";
        }
        
        
    }

    return 0;
    }
    
