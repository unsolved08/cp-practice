#include <bits/stdc++.h>
#define int long long

using namespace std;
signed main() {
    int n,q;
    cin >> n >> q;

    vector<int>v;
    vector<int>ps(n+1);
    vector<int>pp(n);

    
    for (int i = 0; i < n; i++) {
        int element;
        cin >> element;
        v.push_back(element);

    }
    ps[0] = 0;
    for (int j = 0; j < n; j++) {
        ps[j + 1] = ps[j] + v[j];
    }
    pp[0] = 0;
    for (int k = 0; k < n - 1; k++) {
        pp[k + 1] = pp[k] + (v[k + 1] * ps[k + 1]);
    }
    for (int i = 0; i < q; i++) {
        int l, r;
        cin >> l >> r;
        cout << pp[r] - pp[l - 1];
    }

    return 0;
}
