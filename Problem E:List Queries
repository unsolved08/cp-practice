#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    multiset<char>ms;
    for (int i = 0; i < n; i++) {
        string input;
        cin >> input;
        if (input[0] == '+') {
            char element;
            element = input[1];
            ms.insert(element);

        }
        else if(input[0] == '-') {
            char element;
            element = input[1];
            ms.erase(ms.find(element));
        }
        else if (input[0] == '?') {
            char element;
            element = input[1];
            int count = ms.count(element);
            if (count > 0) {
                cout << "YES"<<"\n";
            }
            else {
                cout << "NO"<<"\n";
            }
        }
    }


    return 0;
}
