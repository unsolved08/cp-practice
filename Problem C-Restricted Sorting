#include <bits/stdc++.h

using namespace std;

int main() {
    int n;
    cin >> n;
    vector<pair<long,long>>vp(n);
    
    for (int i = 0; i < n; i++) {
        cin >> vp[i].first;
    }
    for (int i = 0; i < n; i++) {
        cin >> vp[i].second;
    }
    sort(vp.begin(), vp.end());
    int count = 0;
    if (n == 1) {
        cout << "YES";
    }
    else {
        for (int i = 0; i <= n - 2; i++) {
            if (vp[i].second > vp[i + 1].second) {
                count++;
                break;
            }
        }
        if (count == 0) {
            cout << "YES";
        }
        else {
            cout << "NO";
        }
    }
    
    return 0;
}

