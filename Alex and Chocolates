#include <bits/stdc++.h>
#define int long long

using namespace std;
signed main() {

    
    int t;
    cin >> t;
    for (int i = 0;i < t;i++) {
        vector<int>v;
        vector<int>ans;
        int n, k;
        cin >> n >> k;
        for (int j = 0; j < n; j++) {
            int element;
            cin >> element;
            v.push_back(element);
        }
        ans.push_back(0);
        int sum = 0;

        int l = 0;
        int m = n - 1;
        while (l != m) {
            if (v[l] > v[m]) {
                sum = sum + v[l];
                ans.push_back(sum);
                l++;
            }
            else if (v[l] < v[m]) {
                sum = sum + v[m];
                ans.push_back(sum);
                m--;
            }
            else {
                sum = sum + v[m];
                ans.push_back(sum);
                m--;
                sum = sum + v[l];
                ans.push_back(sum);
                l++;
            }
            
        }
        sum = sum + v[l];
        ans.push_back(sum);
        cout << ans[k] << "\n";
    }

    return 0;
}
