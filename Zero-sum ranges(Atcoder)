#include <bits/stdc++.h>
#define int long long

using namespace std;
signed main() {
    int t;
    cin >> t;
    for (int i = 0; i < t; i++) {
        vector<int>v;
        int n;
        cin >> n;
        vector<int>ps(n+1);
        vector<int>counter;
        for (int j = 0; j < n; j++) {
            int element;
            cin >> element;
            v.push_back(element);
        }
        ps[0] = 0;
        for (int k = 0; k < n; k++) {
            ps[k + 1] = ps[k] + v[k];
        }
        sort(ps.begin(), ps.end());
        int p1, p2;
        p1 = 0;
        p2 = 0;
        while (p1 < n + 1 && p2 < n + 1) {
            if (p2 == n) {
                counter.push_back((p2 - p1)+1);
                p2++;
            }
            else if (ps[p1] == ps[p2]) {
                p2++;
            }
            else {
                counter.push_back(p2 - p1);
                p1 = p2;
                p2++;
            }
        }
        int size = counter.size();
        int sum = 0;
        for (int x = 0; x < size; x++) {
            int num = ((counter[x]) * (counter[x] - 1)) / 2;
            sum = sum + num;

        }
        cout << sum << "\n";
    }

    return 0;
    }
    
